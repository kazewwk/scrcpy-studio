diff --git a/app/src/studio_control.c b/app/src/studio_control.c
new file mode 100644
index 0000000..5060cbb
--- /dev/null
+++ b/app/src/studio_control.c
@@ -0,0 +1,116 @@
+#include "studio_control.h"
+
+#include <stdio.h>
+#include <wchar.h>
+#include <windows.h>
+
+#include "events.h"
+#include "util/log.h"
+
+static HANDLE command_pipe;
+static HANDLE stop_event;
+static HANDLE worker;
+
+static DWORD WINAPI
+read_commands(LPVOID userdata) {
+    (void) userdata;
+    HANDLE ready = CreateEventW(NULL, TRUE, FALSE, NULL);
+    if (!ready) {
+        return 0;
+    }
+
+    HANDLE signals[] = {stop_event, ready};
+    OVERLAPPED request = { .hEvent = ready };
+    for (;;) {
+        if (WaitForSingleObject(stop_event, 0) == WAIT_OBJECT_0) {
+            break;
+        }
+
+        DWORD count;
+        unsigned char command;
+        ResetEvent(ready);
+        BOOL ok = ReadFile(command_pipe, &command, 1, &count, &request);
+        if (!ok && GetLastError() == ERROR_IO_PENDING) {
+            DWORD signal = WaitForMultipleObjects(2, signals, FALSE, INFINITE);
+            if (signal != WAIT_OBJECT_0 + 1) {
+                CancelIo(command_pipe);
+                GetOverlappedResult(command_pipe, &request, &count, TRUE);
+                break;
+            }
+            ok = GetOverlappedResult(command_pipe, &request, &count, FALSE);
+        }
+
+        if (!ok || !count || command == 0) {
+            sc_push_event(SDL_EVENT_QUIT);
+            break;
+        }
+
+        SDL_Event event = {
+            .user = { .type = SC_EVENT_STUDIO_SHORTCUT, .code = command },
+        };
+        SDL_PushEvent(&event);
+    }
+
+    CloseHandle(ready);
+    return 0;
+}
+
+void
+sc_studio_control_start(void) {
+    static const wchar_t prefix[] = L"\\\\.\\pipe\\scrcpy-studio-";
+    wchar_t path[128];
+    DWORD len = GetEnvironmentVariableW(L"SCRCPY_STUDIO_PIPE", path, 128);
+    if (!len) {
+        return;
+    }
+    if (len >= 128 || wcsncmp(path, prefix, _countof(prefix) - 1)) {
+        LOGW("Invalid scrcpy Studio control pipe");
+        return;
+    }
+
+    command_pipe = CreateFileW(path, GENERIC_READ, 0, NULL, OPEN_EXISTING,
+                               FILE_FLAG_OVERLAPPED, NULL);
+    if (command_pipe == INVALID_HANDLE_VALUE) {
+        LOGW("Could not open scrcpy Studio control pipe");
+        return;
+    }
+
+    stop_event = CreateEventW(NULL, TRUE, FALSE, NULL);
+    if (!stop_event) {
+        CloseHandle(command_pipe);
+        return;
+    }
+
+    if (SDL_Init(SDL_INIT_EVENTS)) {
+        worker = CreateThread(NULL, 0, read_commands, NULL, 0, NULL);
+        if (worker) {
+            return;
+        }
+        SDL_QuitSubSystem(SDL_INIT_EVENTS);
+    }
+
+    CloseHandle(command_pipe);
+    CloseHandle(stop_event);
+    LOGW("Could not start scrcpy Studio control channel");
+}
+
+void
+sc_studio_control_ready(void) {
+    if (worker) {
+        puts("SCRCPY_STUDIO_READY");
+    }
+}
+
+void
+sc_studio_control_stop(void) {
+    if (!worker) {
+        return;
+    }
+
+    SetEvent(stop_event);
+    WaitForSingleObject(worker, INFINITE);
+    CloseHandle(worker);
+    CloseHandle(stop_event);
+    CloseHandle(command_pipe);
+    SDL_QuitSubSystem(SDL_INIT_EVENTS);
+}
