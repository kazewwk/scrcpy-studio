+static void
+sc_input_manager_studio_shortcut(struct sc_input_manager *im, int command) {
+    static const struct {
+        SDL_Keycode key;
+        bool shift;
+    } shortcuts[128] = {
+        ['h'] = { SDLK_H, false },
+        ['b'] = { SDLK_B, false },
+        ['s'] = { SDLK_S, false },
+        ['m'] = { SDLK_M, false },
+        ['p'] = { SDLK_P, false },
+        ['o'] = { SDLK_O, false },
+        ['O'] = { SDLK_O, true },
+        ['n'] = { SDLK_N, false },
+        ['j'] = { SDLK_N, false },
+        ['N'] = { SDLK_N, true },
+        ['r'] = { SDLK_R, false },
+        ['+'] = { SDLK_UP, false },
+        ['-'] = { SDLK_DOWN, false },
+        ['f'] = { SDLK_F, false },
+        ['['] = { SDLK_LEFT, false },
+        [']'] = { SDLK_RIGHT, false },
+        ['{'] = { SDLK_LEFT, true },
+        ['}'] = { SDLK_DOWN, true },
+        ['z'] = { SDLK_Z, false },
+        ['Z'] = { SDLK_Z, true },
+        ['R'] = { SDLK_R, true },
+        ['g'] = { SDLK_G, false },
+        ['w'] = { SDLK_W, false },
+        ['i'] = { SDLK_I, false },
+        ['c'] = { SDLK_C, false },
+        ['x'] = { SDLK_X, false },
+        ['v'] = { SDLK_V, false },
+        ['V'] = { SDLK_V, true },
+        ['k'] = { SDLK_K, false },
+        ['t'] = { SDLK_T, false },
+        ['T'] = { SDLK_T, true },
+    };
+    if (command < 0 || command >= 128 || !shortcuts[command].key) {
+        return;
+    }
+
+    SDL_KeyboardEvent event = {
+        .type = SDL_EVENT_KEY_DOWN,
+        .key = shortcuts[command].key,
+        .mod = shortcuts[command].shift ? SDL_KMOD_LSHIFT : SDL_KMOD_NONE,
+    };
+    unsigned clicks = command == 'j' ? 2 : 1;
+    sc_input_manager_process_key(im, &event, clicks);
+    event.type = SDL_EVENT_KEY_UP;
+    sc_input_manager_process_key(im, &event, clicks);
+}
