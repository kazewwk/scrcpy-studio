<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBrush" Color="#0D1017" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#090B11" />
    <SolidColorBrush x:Key="CardBrush" Color="#141922" />
    <SolidColorBrush x:Key="InsetBrush" Color="#0E121A" />
    <SolidColorBrush x:Key="InputBrush" Color="#0D1118" />
    <SolidColorBrush x:Key="ControlBrush" Color="#1C222D" />
    <SolidColorBrush x:Key="ControlLineBrush" Color="#2C3544" />
    <SolidColorBrush x:Key="PopupBrush" Color="#1A202B" />
    <SolidColorBrush x:Key="LineBrush" Color="#212936" />
    <SolidColorBrush x:Key="LineStrongBrush" Color="#323C4D" />

    <SolidColorBrush x:Key="TextBrush" Color="#E9EEF6" />
    <SolidColorBrush x:Key="Text2Brush" Color="#A4B0C1" />
    <SolidColorBrush x:Key="Text3Brush" Color="#6F7C8F" />

    <SolidColorBrush x:Key="AccentBrush" Color="#5B8DFF" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#86ABFF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#225B8DFF" />
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#4C8DFF" />
        <GradientStop Offset="1" Color="#7B61FF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#2F6BFF" />
        <GradientStop Offset="0.55" Color="#5A4BF0" />
        <GradientStop Offset="1" Color="#8B3FE8" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="HoverBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="PressBrush" Color="#20FFFFFF" />
    <SolidColorBrush x:Key="ScrollBrush" Color="#66808DA1" />
    <SolidColorBrush x:Key="SwitchOffBrush" Color="#232B38" />
    <SolidColorBrush x:Key="SwitchThumbBrush" Color="#8E9BAE" />

    <SolidColorBrush x:Key="GoodBrush" Color="#3DD68C" />
    <SolidColorBrush x:Key="GoodSoftBrush" Color="#223DD68C" />
    <SolidColorBrush x:Key="WarnBrush" Color="#F5B544" />
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#22F5B544" />
    <SolidColorBrush x:Key="BadBrush" Color="#F47174" />
    <SolidColorBrush x:Key="BadSoftBrush" Color="#22F47174" />

    <SolidColorBrush x:Key="ConsoleBrush" Color="#080A0F" />
    <LinearGradientBrush x:Key="FadeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#000D1017" />
        <GradientStop Offset="1" Color="#FF0D1017" />
    </LinearGradientBrush>

    <DropShadowEffect x:Key="FloatShadow" BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.45" Color="#000000" />
    <DropShadowEffect x:Key="PopupShadow" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.5" Color="#000000" />
    <DropShadowEffect x:Key="GlowShadow" BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.55" Color="#5B6CFF" />
</ResourceDictionary>
