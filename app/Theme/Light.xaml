<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBrush" Color="#F3F5F9" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#FBFCFE" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InsetBrush" Color="#F4F6FA" />
    <SolidColorBrush x:Key="InputBrush" Color="#F7F8FB" />
    <SolidColorBrush x:Key="ControlBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlLineBrush" Color="#D3DAE5" />
    <SolidColorBrush x:Key="PopupBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="LineBrush" Color="#E3E8EF" />
    <SolidColorBrush x:Key="LineStrongBrush" Color="#C9D1DD" />

    <SolidColorBrush x:Key="TextBrush" Color="#17202E" />
    <SolidColorBrush x:Key="Text2Brush" Color="#556173" />
    <SolidColorBrush x:Key="Text3Brush" Color="#8691A2" />

    <SolidColorBrush x:Key="AccentBrush" Color="#2F6BFF" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#2A5BE0" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1A2F6BFF" />
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#2F7BFF" />
        <GradientStop Offset="1" Color="#6A4DFF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#2F74FF" />
        <GradientStop Offset="0.55" Color="#5B50F5" />
        <GradientStop Offset="1" Color="#9247EE" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="HoverBrush" Color="#0E0B1F3A" />
    <SolidColorBrush x:Key="PressBrush" Color="#1C0B1F3A" />
    <SolidColorBrush x:Key="ScrollBrush" Color="#66707C8F" />
    <SolidColorBrush x:Key="SwitchOffBrush" Color="#E6EAF0" />
    <SolidColorBrush x:Key="SwitchThumbBrush" Color="#7C8798" />

    <SolidColorBrush x:Key="GoodBrush" Color="#0E9F6E" />
    <SolidColorBrush x:Key="GoodSoftBrush" Color="#1F0E9F6E" />
    <SolidColorBrush x:Key="WarnBrush" Color="#B7791F" />
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#26D69E2E" />
    <SolidColorBrush x:Key="BadBrush" Color="#D93649" />
    <SolidColorBrush x:Key="BadSoftBrush" Color="#1FD93649" />

    <SolidColorBrush x:Key="ConsoleBrush" Color="#10141C" />
    <LinearGradientBrush x:Key="FadeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#00F3F5F9" />
        <GradientStop Offset="1" Color="#FFF3F5F9" />
    </LinearGradientBrush>

    <DropShadowEffect x:Key="FloatShadow" BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.13" Color="#1B2B4B" />
    <DropShadowEffect x:Key="PopupShadow" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.18" Color="#1B2B4B" />
    <DropShadowEffect x:Key="GlowShadow" BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.4" Color="#4F5DFF" />
</ResourceDictionary>
