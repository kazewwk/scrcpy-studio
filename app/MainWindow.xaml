<Window x:Class="ScrcpyStudio.MainWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ScrcpyStudio"
        Title="scrcpy Studio" Icon="AppIcon.ico" Width="1200" Height="800" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="Shell" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="72" Margin="20,0,0,0">
                        <Grid Width="36" Height="36" VerticalAlignment="Center">
                            <Border CornerRadius="10" Background="{DynamicResource AccentGradientBrush}"
                                    Effect="{DynamicResource GlowShadow}" />
                            <ui:Icon Data="{StaticResource Icon.MonitorSmartphone}" Size="20" Foreground="#FFFFFF"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="scrcpy Studio" FontSize="15.5" FontWeight="SemiBold" />
                            <TextBlock Text="Android 投屏控制台" FontSize="11" Margin="0,2,0,0"
                                       Foreground="{DynamicResource Text3Brush}" />
                        </StackPanel>
                    </StackPanel>

                    <Grid DockPanel.Dock="Bottom" Margin="20,8,12,14">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="VersionText" FontSize="11" Foreground="{DynamicResource Text3Brush}" />
                            <TextBlock Text="scrcpy 5.0.1  ·  Windows x64" FontSize="11" Margin="0,2,0,0"
                                       Foreground="{DynamicResource Text3Brush}" />
                        </StackPanel>
                        <Button x:Name="ThemeButton" Style="{StaticResource Btn.Icon}" HorizontalAlignment="Right"
                                ui:Ui.Icon="{StaticResource Icon.Sun}" ToolTip="切换浅色 / 深色主题"
                                AutomationProperties.Name="切换主题" Click="OnToggleTheme" />
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False">
                        <ListBox x:Name="Nav" Style="{StaticResource BareList}" Margin="10,-8,2,8"
                                 ItemContainerStyle="{StaticResource NavItem}" SelectionChanged="OnNavChanged" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Workspace -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="72" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="28,6,16,0" VerticalAlignment="Center">
                        <TextBlock x:Name="Heading" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="Subheading" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Text3Brush}" />
                    </StackPanel>

                    <Grid Grid.Column="1" Width="264" Height="34" Margin="0,8,14,0" VerticalAlignment="Center"
                          WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBox x:Name="Search" Padding="32,0,34,0" ui:Ui.Hint="搜索全部参数" TextChanged="OnSearchChanged"
                                 AutomationProperties.Name="搜索参数" />
                        <ui:Icon Data="{StaticResource Icon.Search}" Size="15" Margin="11,0,0,0" IsHitTestVisible="False"
                                 HorizontalAlignment="Left" VerticalAlignment="Center"
                                 Foreground="{DynamicResource Text3Brush}" />
                        <Border x:Name="SearchKey" CornerRadius="5" Padding="6,1,6,2" Margin="0,0,7,0"
                                HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False"
                                Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource ControlLineBrush}"
                                BorderThickness="1">
                            <TextBlock Text="Ctrl F" FontSize="10.5" Foreground="{DynamicResource Text3Brush}" />
                        </Border>
                        <Button x:Name="SearchClear" Style="{StaticResource Btn.Icon}" Width="26" Height="26"
                                Margin="0,0,4,0" HorizontalAlignment="Right" Visibility="Collapsed"
                                ui:Ui.Icon="{StaticResource Icon.X}" ToolTip="清除搜索"
                                AutomationProperties.Name="清除搜索" Click="OnSearchClear" />
                    </Grid>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource Btn.Caption}" ui:Ui.Icon="{StaticResource Glyph.Minimize}"
                                Click="OnMinimize" ToolTip="最小化" AutomationProperties.Name="最小化" />
                        <Button x:Name="MaximizeButton" Style="{StaticResource Btn.Caption}"
                                ui:Ui.Icon="{StaticResource Glyph.Maximize}" Click="OnMaximize" />
                        <Button Style="{StaticResource Btn.Caption.Close}" ui:Ui.Icon="{StaticResource Glyph.Close}"
                                Click="OnClose" ToolTip="关闭" AutomationProperties.Name="关闭" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="PageHost" Grid.Row="1" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="PageShift" />
                    </Grid.RenderTransform>
                </Grid>

                <Border Grid.Row="1" Height="16" Margin="0,0,12,0" VerticalAlignment="Bottom" IsHitTestVisible="False"
                        Background="{DynamicResource FadeBrush}" />

                <!-- Toast -->
                <Border x:Name="Toast" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="0,0,0,10" Opacity="0" IsHitTestVisible="False">
                    <Grid>
                        <Border CornerRadius="18" Background="{DynamicResource PopupBrush}"
                                Effect="{DynamicResource PopupShadow}" />
                        <Border CornerRadius="18" BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1"
                                Padding="14,8,18,8">
                            <StackPanel Orientation="Horizontal">
                                <ui:Icon Data="{StaticResource Icon.CircleCheck}" Size="15" VerticalAlignment="Center"
                                         Foreground="{DynamicResource GoodBrush}" />
                                <TextBlock x:Name="ToastText" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Launch bar -->
                <Grid Grid.Row="2" Margin="28,6,28,22">
                    <Border CornerRadius="16" Background="{DynamicResource CardBrush}"
                            Effect="{DynamicResource FloatShadow}" />
                    <Border CornerRadius="16" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                            Padding="18,13,14,13">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Width="10" Height="10" Margin="2,5,12,0" VerticalAlignment="Top">
                                <Ellipse Fill="{DynamicResource GoodBrush}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform />
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tone}" Value="live">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard Name="PulseStory">
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                 From="0.6" To="0" Duration="0:0:1.5" />
                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                                                 From="1" To="3" Duration="0:0:1.5" />
                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                                                 From="1" To="3" Duration="0:0:1.5" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="PulseStory" />
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <Ellipse>
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource Text3Brush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tone}" Value="idle">
                                                    <Setter Property="Fill" Value="{DynamicResource GoodBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tone}" Value="live">
                                                    <Setter Property="Fill" Value="{DynamicResource GoodBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tone}" Value="busy">
                                                    <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tone}" Value="warn">
                                                    <Setter Property="Fill" Value="{DynamicResource WarnBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tone}" Value="bad">
                                                    <Setter Property="Fill" Value="{DynamicResource BadBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Grid>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="StatusText" Text="{Binding Status}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
                                <TextBlock x:Name="CommandText" Text="{Binding Command}"
                                           FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                           Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Text3Brush}" ToolTip="{Binding Command}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                <Button x:Name="CopyButton" Style="{StaticResource Btn.Icon}" Width="38" Height="38"
                                        Margin="0,0,4,0" ui:Ui.Icon="{StaticResource Icon.Copy}" ToolTip="复制 PowerShell 命令"
                                        AutomationProperties.Name="复制命令" Click="OnCopyCommand" />
                                <Button Style="{StaticResource Btn}" Height="38" Margin="0,0,8,0" ui:Ui.Radius="10"
                                        Content="结束暂停" Click="OnResume"
                                        Visibility="{Binding CanResume, Converter={StaticResource BoolToVisibility}}" />
                                <Button Style="{StaticResource Btn}" Height="38" Margin="0,0,8,0" ui:Ui.Radius="10"
                                        ui:Ui.Icon="{StaticResource Icon.Square}" Content="{Binding StopText}"
                                        IsEnabled="{Binding CanStop}" Click="OnStop" />
                                <Grid>
                                    <Border CornerRadius="10" Background="{DynamicResource AccentBrush}" Margin="6,8,6,2"
                                            Effect="{DynamicResource GlowShadow}"
                                            Visibility="{Binding CanStart, Converter={StaticResource BoolToVisibility}}" />
                                    <Button x:Name="StartButton" Style="{StaticResource Btn.Primary}" Height="38"
                                            Padding="18,0,20,0" ui:Ui.Radius="10" ui:Ui.Icon="{StaticResource Icon.Play}"
                                            Content="开始投屏" IsEnabled="{Binding CanStart}" Click="OnStart" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
