<UserControl x:Class="ScrcpyStudio.OptionsPage" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:ScrcpyStudio">
    <UserControl.Resources>
        <Style x:Key="RowHit" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Border x:Name="tint" Margin="5,3" CornerRadius="10" Background="{DynamicResource HoverBrush}"
                                    Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tint" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="OptionRow">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="line" Height="1" Margin="20,0" VerticalAlignment="Top"
                        Background="{DynamicResource LineBrush}" />
                <ToggleButton Style="{StaticResource RowHit}" IsChecked="{Binding IsExpanded}"
                              AutomationProperties.Name="{Binding Title, StringFormat={}{0} 说明}" />
                <Border x:Name="mark" Width="3" Height="22" CornerRadius="1.5" HorizontalAlignment="Left"
                        VerticalAlignment="Center" Background="{DynamicResource AccentGradientBrush}"
                        Visibility="Hidden" IsHitTestVisible="False" />

                <Grid Margin="20,0,16,0" MinHeight="62">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,10,14,11" VerticalAlignment="Center" IsHitTestVisible="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                            <Border x:Name="group" Style="{StaticResource Tag}" Visibility="Collapsed">
                                <TextBlock Text="{Binding Group}" FontSize="10.5" Foreground="{DynamicResource Text2Brush}" />
                            </Border>
                            <Border x:Name="linux" Style="{StaticResource Tag}" Visibility="Collapsed"
                                    Background="{DynamicResource WarnSoftBrush}" BorderThickness="0" Padding="7,2,7,3">
                                <TextBlock Text="仅 Linux" FontSize="10.5" Foreground="{DynamicResource WarnBrush}" />
                            </Border>
                            <Border x:Name="blank" Style="{StaticResource Tag}" Visibility="Collapsed"
                                    Background="{DynamicResource WarnSoftBrush}" BorderThickness="0" Padding="7,2,7,3">
                                <TextBlock Text="尚未填写值" FontSize="10.5" Foreground="{DynamicResource WarnBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding FlagText}" Margin="0,4,0,0" FontFamily="{StaticResource MonoFont}"
                                   FontSize="11.5" Foreground="{DynamicResource Text3Brush}" />
                    </StackPanel>

                    <StackPanel x:Name="editor" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="run" Style="{StaticResource Btn}" Height="32" Visibility="Collapsed"
                                ui:Ui.Icon="{StaticResource Icon.Play}" Content="立即查询" Click="OnQuery"
                                IsEnabled="{Binding DataContext.CanQuery, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <TextBox x:Name="text" Width="230" Visibility="Collapsed" ui:Ui.Hint="{Binding Hint}"
                                 Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{Binding Title}" />
                        <ComboBox x:Name="combo" Width="230" Visibility="Collapsed" IsEditable="True"
                                  IsTextSearchEnabled="False" ItemsSource="{Binding Choices}" ui:Ui.Hint="{Binding Hint}"
                                  Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                  AutomationProperties.Name="{Binding Title}" />
                        <Button x:Name="pick" Style="{StaticResource Btn}" Width="34" Padding="0" Margin="6,0,0,0"
                                Visibility="Collapsed" ui:Ui.Icon="{StaticResource Icon.FolderOpen}" ToolTip="选择…"
                                AutomationProperties.Name="选择…" Click="OnPick" />
                    </StackPanel>

                    <ToggleButton Grid.Column="2" Style="{StaticResource Switch}" Margin="14,0,0,0"
                                  IsChecked="{Binding IsOn}" ToolTip="{Binding SwitchTip}"
                                  AutomationProperties.Name="{Binding Title}" />
                    <ui:Icon x:Name="chevron" Grid.Column="3" Data="{StaticResource Icon.ChevronDown}" Size="15"
                             Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                             Foreground="{DynamicResource Text3Brush}" RenderTransformOrigin="0.5,0.5">
                        <ui:Icon.RenderTransform>
                            <RotateTransform Angle="0" />
                        </ui:Icon.RenderTransform>
                    </ui:Icon>
                </Grid>

                <Border x:Name="details" Grid.Row="1" Margin="20,0,20,16" Padding="16,13,16,14" CornerRadius="11"
                        Background="{DynamicResource InsetBrush}" BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="语法" FontSize="11.5" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Text3Brush}" />
                            <TextBlock Text="{Binding Syntax}" Margin="10,0,0,0" FontFamily="{StaticResource MonoFont}"
                                       FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentTextBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" Margin="0,9,0,0" TextWrapping="Wrap" FontSize="12.5"
                                   LineHeight="19" Foreground="{DynamicResource Text2Brush}" />
                        <StackPanel x:Name="note" Orientation="Horizontal" Margin="0,10,0,0">
                            <ui:Icon Data="{StaticResource Icon.Info}" Size="13" VerticalAlignment="Center"
                                     Foreground="{DynamicResource Text3Brush}" />
                            <TextBlock Text="{Binding Note}" Margin="7,0,0,0" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Text3Brush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                    <Setter TargetName="line" Property="Visibility" Value="Hidden" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasText}" Value="True">
                    <Setter TargetName="text" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasChoices}" Value="True">
                    <Setter TargetName="combo" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasPicker}" Value="True">
                    <Setter TargetName="pick" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsColor}" Value="True">
                    <Setter TargetName="pick" Property="ui:Ui.Icon" Value="{StaticResource Icon.Palette}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsQuery}" Value="True">
                    <Setter TargetName="run" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLinux}" Value="True">
                    <Setter TargetName="linux" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ShowGroup}" Value="True">
                    <Setter TargetName="group" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBlank}" Value="True">
                    <Setter TargetName="blank" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Note}" Value="{x:Null}">
                    <Setter TargetName="note" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOn}" Value="True">
                    <Setter TargetName="mark" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOn}" Value="False">
                    <Setter TargetName="text" Property="Opacity" Value="0.62" />
                    <Setter TargetName="combo" Property="Opacity" Value="0.62" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="details" Property="Visibility" Value="Visible" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="chevron"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                 To="180" Duration="0:0:0.16" />
                                <DoubleAnimation Storyboard.TargetName="details" Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.18" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="chevron"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                 To="0" Duration="0:0:0.16" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
        <StackPanel Margin="28,4,18,16">
            <Border x:Name="ListCard" Style="{StaticResource Card}" Padding="0,2">
                <ItemsControl x:Name="List" ItemTemplate="{StaticResource OptionRow}" Focusable="False" />
            </Border>
            <StackPanel x:Name="Empty" Margin="0,90,0,0" HorizontalAlignment="Center" Visibility="Collapsed">
                <Border Width="56" Height="56" CornerRadius="18" Background="{DynamicResource AccentSoftBrush}"
                        HorizontalAlignment="Center">
                    <ui:Icon Data="{StaticResource Icon.Search}" Size="24" HorizontalAlignment="Center"
                             VerticalAlignment="Center" Foreground="{DynamicResource AccentTextBrush}" />
                </Border>
                <TextBlock Text="没有匹配的选项" Margin="0,16,0,0" FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="可以尝试中文名称、--参数名或短参数，例如 fps、--record、-m" Margin="0,6,0,0"
                           HorizontalAlignment="Center" Foreground="{DynamicResource Text3Brush}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
