<UserControl x:Class="ScrcpyStudio.ControlPage" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:ScrcpyStudio">
    <UserControl.Resources>
        <ItemsPanelTemplate x:Key="TileWrap">
            <UniformGrid Columns="7" />
        </ItemsPanelTemplate>
        <DataTemplate x:Key="ActionTile">
            <Button Style="{StaticResource Btn.Tile}" Height="74" Margin="0,0,10,10" ui:Ui.Icon="{Binding Icon}"
                    Content="{Binding Text}" Tag="{Binding Hint}" Click="OnAction"
                    IsEnabled="{Binding DataContext.CanControl, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="28,4,18,16">
            <Border CornerRadius="12" Padding="14,11" Margin="0,0,0,14" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CanControl}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource GoodSoftBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <ui:Icon DockPanel.Dock="Left" Size="16" Margin="0,0,10,0" VerticalAlignment="Center">
                        <ui:Icon.Style>
                            <Style TargetType="ui:Icon">
                                <Setter Property="Data" Value="{StaticResource Icon.Info}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanControl}" Value="True">
                                        <Setter Property="Data" Value="{StaticResource Icon.CircleCheck}" />
                                        <Setter Property="Foreground" Value="{DynamicResource GoodBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Icon.Style>
                    </ui:Icon>
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="开始投屏并等待投屏窗口打开后，下面的按钮即可使用。OTG 与隐藏窗口的会话不提供这些控制。" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanControl}" Value="True">
                                        <Setter Property="Text" Value="会话已连接，点击按钮即可向投屏窗口发送对应指令。" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20,18,10,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource IconChip}">
                            <ui:Icon Data="{StaticResource Icon.Smartphone}" Size="16" HorizontalAlignment="Center"
                                     VerticalAlignment="Center" Foreground="{DynamicResource AccentTextBrush}" />
                        </Border>
                        <TextBlock Style="{StaticResource CardTitle}" Text="手机控制" />
                    </StackPanel>
                    <ItemsControl x:Name="DeviceActions" Margin="0,14,0,0" Focusable="False"
                                  ItemsPanel="{StaticResource TileWrap}" ItemTemplate="{StaticResource ActionTile}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20,18,10,8" Margin="0,14,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource IconChip}">
                            <ui:Icon Data="{StaticResource Icon.Monitor}" Size="16" HorizontalAlignment="Center"
                                     VerticalAlignment="Center" Foreground="{DynamicResource AccentTextBrush}" />
                        </Border>
                        <TextBlock Style="{StaticResource CardTitle}" Text="投屏画面" />
                    </StackPanel>
                    <ItemsControl x:Name="DisplayActions" Margin="0,14,0,0" Focusable="False"
                                  ItemsPanel="{StaticResource TileWrap}" ItemTemplate="{StaticResource ActionTile}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20,18,10,8" Margin="0,14,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource IconChip}">
                            <ui:Icon Data="{StaticResource Icon.ClipboardPaste}" Size="16" HorizontalAlignment="Center"
                                     VerticalAlignment="Center" Foreground="{DynamicResource AccentTextBrush}" />
                        </Border>
                        <TextBlock Style="{StaticResource CardTitle}" Text="剪贴板与相机" />
                    </StackPanel>
                    <ItemsControl x:Name="ExtraActions" Margin="0,14,0,0" Focusable="False"
                                  ItemsPanel="{StaticResource TileWrap}" ItemTemplate="{StaticResource ActionTile}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource IconChip}">
                            <ui:Icon Data="{StaticResource Icon.MousePointerClick}" Size="16" HorizontalAlignment="Center"
                                     VerticalAlignment="Center" Foreground="{DynamicResource AccentTextBrush}" />
                        </Border>
                        <TextBlock Style="{StaticResource CardTitle}" Text="投屏窗口操作" />
                    </StackPanel>
                    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="21"
                               Foreground="{DynamicResource Text2Brush}"
                               Text="将文件拖入投屏窗口可推送文件或安装 APK。按住 Ctrl 拖动可双指缩放和旋转，按住 Shift 拖动可模拟双指滑动。按钮下方标注的 MOD 默认是左 Alt 或左 Win 键。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
