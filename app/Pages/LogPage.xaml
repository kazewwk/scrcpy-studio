<UserControl x:Class="ScrcpyStudio.LogPage" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:ScrcpyStudio">
    <Grid Margin="28,4,28,16">
        <Border CornerRadius="14" Background="{DynamicResource ConsoleBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1" />
        <DockPanel>
            <DockPanel.Resources>
                <!-- The console stays dark in both themes, so its buttons keep light-on-dark feedback. -->
                <SolidColorBrush x:Key="HoverBrush" Color="#1AFFFFFF" />
                <SolidColorBrush x:Key="PressBrush" Color="#2BFFFFFF" />
                <SolidColorBrush x:Key="ScrollBrush" Color="#66808DA1" />
            </DockPanel.Resources>
            <Grid DockPanel.Dock="Top" Height="46" Margin="18,0,10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="#F47174" />
                    <Ellipse Width="10" Height="10" Fill="#F5B544" Margin="7,0,0,0" />
                    <Ellipse Width="10" Height="10" Fill="#3DD68C" Margin="7,0,0,0" />
                    <TextBlock x:Name="Counter" Margin="16,0,0,0" FontSize="12" VerticalAlignment="Center"
                               Foreground="#7E8B9E" FontFamily="{StaticResource MonoFont}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource Btn.Ghost}" Height="30" Padding="10,0" Foreground="#A4B0C1"
                            ui:Ui.Icon="{StaticResource Icon.Copy}" Content="复制" Click="OnCopy" />
                    <Button Style="{StaticResource Btn.Ghost}" Height="30" Padding="10,0" Foreground="#A4B0C1"
                            ui:Ui.Icon="{StaticResource Icon.Trash}" Content="清空" Click="OnClear" />
                </StackPanel>
            </Grid>
            <Border DockPanel.Dock="Top" Height="1" Background="#1AFFFFFF" />
            <Grid>
                <RichTextBox x:Name="Box" IsReadOnly="True" IsReadOnlyCaretVisible="False" Background="Transparent"
                             BorderThickness="0" Padding="12,10,4,10" Foreground="#C9D4E3" FontSize="12.5"
                             FontFamily="{StaticResource MonoFont}" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled" SelectionBrush="#5B8DFF"
                             FocusVisualStyle="{x:Null}" AutomationProperties.Name="运行日志">
                    <RichTextBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="复制" Command="ApplicationCommands.Copy" />
                            <MenuItem Header="全选" Command="ApplicationCommands.SelectAll" />
                        </ContextMenu>
                    </RichTextBox.ContextMenu>
                    <RichTextBox.Template>
                        <ControlTemplate TargetType="RichTextBox">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="{TemplateBinding Padding}" />
                        </ControlTemplate>
                    </RichTextBox.Template>
                    <FlowDocument PagePadding="0" />
                </RichTextBox>
                <StackPanel x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <ui:Icon Data="{StaticResource Icon.SquareTerminal}" Size="34" Stroke="1.5" Foreground="#3A4556"
                             HorizontalAlignment="Center" />
                    <TextBlock Text="暂无输出" Margin="0,12,0,0" FontSize="14" Foreground="#7E8B9E"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="开始投屏或执行查询后，scrcpy 与 ADB 的输出会显示在这里" Margin="0,5,0,0" FontSize="12"
                               Foreground="#566273" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
