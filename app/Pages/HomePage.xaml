<UserControl x:Class="ScrcpyStudio.HomePage" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:ScrcpyStudio">
    <UserControl.Resources>
        <ControlTemplate x:Key="DeviceCard" TargetType="ListBoxItem">
            <Grid Margin="0,0,12,12" Height="68" Background="Transparent">
                <Border CornerRadius="13" Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" />
                <Border x:Name="tint" CornerRadius="13" Background="{DynamicResource HoverBrush}" Opacity="0" />
                <Border x:Name="ring" CornerRadius="13" Background="{DynamicResource AccentSoftBrush}"
                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" Visibility="Hidden" />
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="38" Height="38" VerticalAlignment="Center">
                        <Border CornerRadius="11" Background="{DynamicResource InsetBrush}"
                                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" />
                        <Border x:Name="chipOn" CornerRadius="11" Background="{DynamicResource AccentGradientBrush}"
                                Visibility="Hidden" />
                        <ui:Icon x:Name="icon" Data="{Binding Icon}" Size="18" HorizontalAlignment="Center"
                                 VerticalAlignment="Center" Foreground="{DynamicResource Text2Brush}" />
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}" FontSize="11.5" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Text3Brush}" />
                    </StackPanel>
                    <Border x:Name="state" Grid.Column="2" Height="20" CornerRadius="10" Padding="8,0"
                            VerticalAlignment="Center" Background="{DynamicResource InsetBrush}">
                        <TextBlock x:Name="stateText" Text="{Binding State}" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Text2Brush}" />
                    </Border>
                </Grid>
            </Grid>
            <ControlTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="">
                    <Setter TargetName="state" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="good">
                    <Setter TargetName="state" Property="Background" Value="{DynamicResource GoodSoftBrush}" />
                    <Setter TargetName="stateText" Property="Foreground" Value="{DynamicResource GoodBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="warn">
                    <Setter TargetName="state" Property="Background" Value="{DynamicResource WarnSoftBrush}" />
                    <Setter TargetName="stateText" Property="Foreground" Value="{DynamicResource WarnBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="accent">
                    <Setter TargetName="state" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                    <Setter TargetName="stateText" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="tint" Property="Opacity" Value="1" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="ring" Property="Visibility" Value="Visible" />
                    <Setter TargetName="chipOn" Property="Visibility" Value="Visible" />
                    <Setter TargetName="icon" Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="28,4,18,16">
            <!-- Hero -->
            <Grid Height="124">
                <Border CornerRadius="16" Background="{DynamicResource HeroBrush}" />
                <Border CornerRadius="16">
                    <Border.Background>
                        <RadialGradientBrush Center="0.82,-0.1" GradientOrigin="0.82,-0.1" RadiusX="0.55" RadiusY="1.5">
                            <GradientStop Offset="0" Color="#66FFFFFF" />
                            <GradientStop Offset="1" Color="#00FFFFFF" />
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>
                <Border CornerRadius="16">
                    <Border.Background>
                        <RadialGradientBrush Center="0.05,1.3" GradientOrigin="0.05,1.3" RadiusX="0.45" RadiusY="1.3">
                            <GradientStop Offset="0" Color="#5900D0FF" />
                            <GradientStop Offset="1" Color="#0000D0FF" />
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>
                <ui:Icon Data="{StaticResource Icon.MonitorSmartphone}" Size="104" Stroke="1.1" Foreground="#24FFFFFF"
                         HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,168,0" />
                <Grid Margin="26,0,22,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding DeviceTitle}" FontSize="22" FontWeight="SemiBold" Foreground="#FFFFFF" />
                        <TextBlock Text="{Binding DeviceHint}" Margin="0,7,0,0" Foreground="#E6FFFFFF"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource Btn.Glass}" VerticalAlignment="Center"
                            ui:Ui.Icon="{StaticResource Icon.RefreshCw}" Content="刷新设备"
                            IsEnabled="{Binding AdbReady}" Click="OnRefresh" />
                </Grid>
            </Grid>

            <!-- Devices -->
            <ListBox Style="{StaticResource BareList}" Margin="0,14,-12,0" ItemsSource="{Binding Devices}"
                     SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" AutomationProperties.Name="Android 设备">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template" Value="{StaticResource DeviceCard}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Wireless debugging -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource IconChip}">
                                <ui:Icon Data="{StaticResource Icon.Wifi}" Size="16" HorizontalAlignment="Center"
                                         VerticalAlignment="Center" Foreground="{DynamicResource AccentTextBrush}" />
                            </Border>
                            <TextBlock Style="{StaticResource CardTitle}" Text="无线调试" />
                        </StackPanel>
                        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Text2Brush}"
                                   Text="在手机的无线调试页面查看配对地址和连接地址，两者通常使用不同端口。" />

                        <TextBlock Text="首次配对" Margin="0,15,0,6" FontSize="12" Foreground="{DynamicResource Text3Brush}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PairAddress" ui:Ui.Hint="配对地址 IP:端口" AutomationProperties.Name="配对地址" />
                            <PasswordBox x:Name="PairCode" Grid.Column="2" MaxLength="6" ui:Ui.Hint="六位配对码"
                                         AutomationProperties.Name="配对码" />
                            <Button Grid.Column="4" Style="{StaticResource Btn}" ui:Ui.Icon="{StaticResource Icon.KeyRound}"
                                    Content="配对" IsEnabled="{Binding AdbReady}" Click="OnPair" />
                        </Grid>

                        <TextBlock Text="连接设备" Margin="0,14,0,6" FontSize="12" Foreground="{DynamicResource Text3Brush}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ConnectAddress" ui:Ui.Hint="连接地址 IP:端口" AutomationProperties.Name="连接地址" />
                            <Button Grid.Column="2" Style="{StaticResource Btn}" ui:Ui.Icon="{StaticResource Icon.Link}"
                                    Content="连接" IsEnabled="{Binding AdbReady}" Click="OnConnect" />
                            <Button Grid.Column="4" Style="{StaticResource Btn}" ui:Ui.Icon="{StaticResource Icon.Unlink}"
                                    Content="断开" IsEnabled="{Binding AdbReady}" Click="OnDisconnect" />
                        </Grid>

                        <Border Margin="0,14,0,0" CornerRadius="10" Padding="12,9" Background="{DynamicResource InsetBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AdbNote}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <ui:Icon DockPanel.Dock="Left" Data="{StaticResource Icon.Info}" Size="14" Margin="0,2,8,0"
                                         VerticalAlignment="Top" Foreground="{DynamicResource Text3Brush}" />
                                <TextBlock Text="{Binding AdbNote}" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource Text2Brush}" />
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Shortcuts -->
                <Border Grid.Column="2" Style="{StaticResource Card}" MinHeight="236">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                            <Border Style="{StaticResource IconChip}">
                                <ui:Icon Data="{StaticResource Icon.Zap}" Size="16" HorizontalAlignment="Center"
                                         VerticalAlignment="Center" Foreground="{DynamicResource AccentTextBrush}" />
                            </Border>
                            <TextBlock Style="{StaticResource CardTitle}" Text="常用设置" />
                        </StackPanel>
                        <ItemsControl x:Name="Shortcuts" Margin="0,14,-10,-10" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" Rows="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Btn.Tile}" Margin="0,0,10,10" ui:Ui.Icon="{Binding Icon}"
                                            Content="{Binding Text}" Click="OnShortcut" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Capability queries -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource IconChip}">
                            <ui:Icon Data="{StaticResource Icon.Scan}" Size="16" HorizontalAlignment="Center"
                                     VerticalAlignment="Center" Foreground="{DynamicResource AccentTextBrush}" />
                        </Border>
                        <TextBlock Style="{StaticResource CardTitle}" Text="查询设备能力" />
                        <TextBlock Text="结果显示在运行日志" Margin="12,1,0,0" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Text3Brush}" />
                    </StackPanel>
                    <ItemsControl x:Name="Queries" Margin="0,14,0,-8" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Btn.Chip}" Margin="0,0,8,8" ui:Ui.Icon="{Binding Icon}"
                                        Content="{Binding Text}" Click="OnQuery"
                                        IsEnabled="{Binding DataContext.CanQuery, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
